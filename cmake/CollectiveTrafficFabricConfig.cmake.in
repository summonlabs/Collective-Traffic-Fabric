@PACKAGE_INIT@

# CollectiveTrafficFabricConfig.cmake - package configuration for downstream
# consumers.  Imported target: ctf::collective_traffic_fabric
#
#   find_package(CollectiveTrafficFabric 1.0 REQUIRED)
#   target_link_libraries(my_target PRIVATE ctf::collective_traffic_fabric)
include(CMakeFindDependencyMacro)
set(THREADS_PREFER_PTHREAD_FLAG ON)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/CollectiveTrafficFabricTargets.cmake")

set(CollectiveTrafficFabric_VERSION "@PROJECT_VERSION@")
check_required_components(CollectiveTrafficFabric)
